{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs"]
    },
    "install": {
      "cmds": ["cd backend && npm install"]
    },
    "build": {
      "cmds": ["cd backend && npx prisma generate && npx tsc"]
    }
  },
  "deploy": {
    "startCommand": "cd backend && node dist/index.js"
  }
}